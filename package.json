{
  "name": "agents-100-system",
  "version": "1.0.0",
  "description": "100-Agent Orchestration System with Trading Bots",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:server": "tsx watch src/server.ts",
    "dev:personal-trading": "tsx watch src/personal-trading.ts",
    "start": "node dist/index.js",
    "start:server": "node dist/server.js",
    "start:orchestrator": "npm run build && node dist/server.js",
    "build": "tsc",
    "test": "jest",
    "test:agent": "tsx src/test-agent.ts",
    "test:agent2": "tsx src/test-agent-2.ts",
    "test:agent3": "tsx src/test-agent-3.ts",
    "test:agent4": "tsx src/test-agent-4.ts",
    "test:agent5": "tsx src/test-agent-5.ts",
    "test:agent6": "tsx src/test-agent-6.ts",
    "test:agent7": "tsx src/test-agent-7.ts",
    "test:agent8": "tsx src/test-agent-8.ts",
    "test:agent9": "tsx src/test-agent-9.ts",
    "test:all": "tsx src/test-agent.ts && tsx src/test-agent-2.ts && tsx src/test-agent-3.ts && tsx src/test-agent-4.ts && tsx src/test-agent-5.ts && tsx src/test-agent-6.ts && tsx src/test-agent-7.ts && tsx src/test-agent-8.ts && tsx src/test-agent-9.ts",
    "deploy": "npm run build && git push",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "node-schedule": "^2.1.1",
    "pg": "^8.10.0",
    "redis": "^4.6.0",
    "uuid": "^9.0.0",
    "winston": "^3.8.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.19.43",
    "@types/node-schedule": "^2.1.8",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "tsx": "^3.14.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
