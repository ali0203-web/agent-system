# Node Environment
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://localhost/agents

# Cache (Redis)
REDIS_URL=redis://localhost:6379

# API Keys
# COINGECKO_API_KEY=your_api_key_here

# Server Configuration
API_TIMEOUT=15000
MAX_RETRIES=3
RETRY_DELAY_MS=2000

# Features
ENABLE_DATABASE_PERSISTENCE=true
ENABLE_REDIS_CACHE=true
ENABLE_WEBHOOKS=false

# Webhook Configuration (optional)
# WEBHOOK_PUMP_DUMP_URL=https://your-webhook.com/pump-dump
# WEBHOOK_PORTFOLIO_URL=https://your-webhook.com/portfolio
# WEBHOOK_PRICE_ALERT_URL=https://your-webhook.com/price-alert

# Monitoring & Alerts
ENABLE_SLACK_ALERTS=false
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

ENABLE_EMAIL_ALERTS=false
# EMAIL_SERVICE=gmail
# EMAIL_FROM=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password
# EMAIL_TO=alerts@example.com
