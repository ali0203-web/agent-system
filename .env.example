# AgentOS Trading System Configuration

# API Authentication & Security
# Comma-separated list of valid API keys for accessing /api/* endpoints
API_KEYS=default-api-key-demo,sk-your-api-key-here-123456

# Admin API key for sensitive operations
ADMIN_API_KEY=sk-admin-super-secret-key-change-this

# CORS: Allowed origins (comma-separated, or * for all)
ALLOWED_ORIGINS=*

# Binance API Configuration (Testnet by default)
USE_TESTNET=true
BINANCE_TESTNET_KEY=your-testnet-api-key
BINANCE_TESTNET_SECRET=your-testnet-api-secret

# Monitoring & Alerting
# Slack webhook URL for alert notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Discord webhook URL for alert notifications
DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/YOUR/WEBHOOK/URL

# Database Configuration (Optional - uses in-memory fallback)
DATABASE_URL=postgresql://user:password@localhost:5432/agent-system

# Application Settings
NODE_ENV=production
LOG_LEVEL=info
PORT=3000
